VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep provider credentials in Supabase Edge Function secrets, never VITE_ variables.
# For local Edge Functions, use supabase/functions/.env (ignored by Git).
# Razorpay is test-only and the demo order is fixed at ₹499.00 INR.
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# APP_URL=http://localhost:5173

# Other optional provider secrets:
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# Set true for a Twilio trial; SMS requests use a predefined template. A free trial cannot send custom campaign text.
# TWILIO_SMS_TRIAL_MODE=false
# TWILIO_SMS_TRIAL_BODY=sms_event_notifications
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_CONTENT_SID=
# Trial-only switch: allows opted-in self-delivery checks without a Verify Service
# and sends the preset WhatsApp template without custom variables.
# TWILIO_WHATSAPP_SANDBOX_MODE=false
# Twilio Verify Service SID configured with WhatsApp as a verification channel.
# The Profile flow requires this one-time phone verification before WhatsApp alerts:
# TWILIO_VERIFY_SERVICE_SID=
